            },
            "musictoplay": 0,
            "voicepitch": 0.0
        },
        {
            "Charactername": "Mir",
            "text": "Don't mention it. I was only doing my job.",
            "CameraDestination": {
                "x": 0.0,
                "y": 0.0,
                "z": 0.0
            },
            "Portrait": {
                "instanceID": 57272
            },
